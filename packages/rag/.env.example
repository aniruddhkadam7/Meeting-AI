RAG_HOST=127.0.0.1
RAG_PORT=8100

# Defaults to %APPDATA%\Smallbird\knowledge if unset. Never point this
# inside the repository — user documents must stay local and out of source
# control.
RAG_DATA_DIR=

MAX_DOCUMENT_SIZE_MB=25

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=80

LOG_LEVEL=INFO
