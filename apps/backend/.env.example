BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated list of allowed origins for the desktop app's WebView to call
# this API from. Do not use "*" — keep this an explicit allowlist, including in
# any future production configuration.
CORS_ALLOW_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,https://tauri.localhost

# LLM provider selection: openai | anthropic | mock
# "mock" requires no API key and is also the automatic fallback whenever the
# configured provider's API key is missing.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Interview Mode's live "ask" endpoint runs on its own (fast, inexpensive)
# model, independent of LLM_MODEL above which is used by the offline
# full-interview analysis pipeline. Falls back to LLM_MODEL when unset.
ASK_LLM_MODEL=gpt-4o-mini
# 0.0-1.0 — slightly warmer than the analysis pipeline so live answers read
# as natural speech rather than a deterministic report.
ASK_TEMPERATURE=0.4
# Default max tokens for a live interview answer; "brief"/"detailed" answer
# lengths scale this down/up per-request (see app/services/ask_service.py).
MAX_ANSWER_TOKENS=250

# Cost/context controls for the offline analysis pipeline.
MAX_QUESTIONS_TO_ANALYZE=50
TOP_K_RETRIEVAL=5
MAX_CONTEXT_CHARS=6000
MAX_OUTPUT_TOKENS=1500

LOG_LEVEL=INFO
