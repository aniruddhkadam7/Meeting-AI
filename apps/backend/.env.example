BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated list of allowed origins for the desktop app's WebView to call
# this API from. Do not use "*" — keep this an explicit allowlist, including in
# any future production configuration.
CORS_ALLOW_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,https://tauri.localhost

# LLM provider selection: openai | anthropic | mock
# "mock" requires no API key and is also the automatic fallback whenever the
# configured provider's API key is missing.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Interview Mode's live "ask" endpoint runs on its own (fast, inexpensive)
# model, independent of LLM_MODEL above which is used by the offline
# full-interview analysis pipeline. Falls back to LLM_MODEL when unset.
ASK_LLM_MODEL=gpt-4o-mini
# 0.0-1.0 — slightly warmer than the analysis pipeline so live answers read
# as natural speech rather than a deterministic report.
ASK_TEMPERATURE=0.4
# Default max tokens for a live interview answer; "brief"/"detailed" answer
# lengths scale this down/up per-request (see app/services/ask_service.py).
MAX_ANSWER_TOKENS=250

# Cost/context controls for the offline analysis pipeline.
MAX_QUESTIONS_TO_ANALYZE=50
TOP_K_RETRIEVAL=5
MAX_CONTEXT_CHARS=6000
MAX_OUTPUT_TOKENS=1500

LOG_LEVEL=INFO

# --- Smallbird Cloud: Supabase Auth + Postgres ---
# Project URL, from Supabase dashboard -> Project Settings -> API. Same
# value apps/desktop is configured with (see supabase/README.md) — safe to
# be non-secret; Row Level Security is what actually protects data, not key
# secrecy. (The backend has no use for the desktop's anon/publishable key —
# only the JWT secret and secret key below, which the desktop must never have.)
SUPABASE_URL=
# Legacy JWT Secret, from Supabase dashboard -> Project Settings -> API ->
# JWT Keys -> "Legacy JWT Secret" tab (NOT the newer ECC/P-256 signing key —
# app/core/auth.py verifies HS256 against this shared secret). Used to
# verify, never to mint, session tokens issued by Supabase Auth on the desktop.
SUPABASE_JWT_SECRET=
# Secret API key ("secret key", starts with sb_secret_...), from Supabase
# dashboard -> Project Settings -> API -> Secret keys. Backend-only —
# bypasses Row Level Security. Never send this to the desktop app or any
# client-facing code.
SUPABASE_SERVICE_ROLE_KEY=

# Rough USD-per-1K-token pricing used only to populate usage_costs for cost
# visibility — not billing-accurate, not used for any enforcement.
PRICE_PER_1K_INPUT_USD=0.00015
PRICE_PER_1K_OUTPUT_USD=0.0006
