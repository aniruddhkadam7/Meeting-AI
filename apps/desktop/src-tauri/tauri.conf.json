{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhitedotAI",
  "version": "0.1.0",
  "identifier": "com.whitedotai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WhitedotAI",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCMUQ1QzkzODVCNzAwQTkKUldTcEFMZUZrMXdkVzhKVHIrY2FvcTlGd2l3eVBZbmptMlpFQzFOK3BZNDdKM004WkpOSmZCbWkK",
      "endpoints": [
        "https://releases.whitedotai.app/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
