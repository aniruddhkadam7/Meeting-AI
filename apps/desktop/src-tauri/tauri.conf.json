{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smallbird",
  "version": "0.1.0",
  "identifier": "com.smallbird.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Smallbird",
        "width": 760,
        "height": 56,
        "minWidth": 760,
        "minHeight": 56,
        "resizable": true,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packages/stt/dist/stt-sidecar": "stt-sidecar",
      "../../../models/stt/nemo-fastconformer-80ms-int8": "stt-model",
      "../../../packages/rag/dist/rag-lite": "rag-lite"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCMUQ1QzkzODVCNzAwQTkKUldTcEFMZUZrMXdkVzhKVHIrY2FvcTlGd2l3eVBZbmptMlpFQzFOK3BZNDdKM004WkpOSmZCbWkK",
      "endpoints": [
        "https://releases.smallbird.app/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
