# WhitedotAI Desktop — WhitedotAI Cloud connection
#
# IMPORTANT: this file is documentation only. Neither Tauri nor this app's
# Rust code loads a .env file at runtime (same as the existing BACKEND_URL
# variable — see src-tauri/src/backend/config.rs) — these must be set as
# real process environment variables in the shell/session you run
# `npm run tauri dev` / `npm run tauri build` from, e.g. (PowerShell):
#   $env:SUPABASE_URL = "https://xxxx.supabase.co"
#   $env:SUPABASE_ANON_KEY = "sb_publishable_..."
#   npm run tauri dev
#
# Read by src-tauri/src/auth/config.rs::supabase_url() / supabase_anon_key().
# Without these set, Account shows "WhitedotAI Cloud isn't configured on this
# build" and the rest of the app (recording, transcript, local agents)
# works exactly as before — cloud sign-in/sync is opt-in, not required.

# Project URL, from Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=

# Publishable key ("Publishable API key", starts with sb_publishable_...),
# from Supabase dashboard -> Project Settings -> API -> Publishable key.
# Safe to embed/ship in a client — it identifies the project, not a user.
# Row Level Security (supabase/migrations/0001_init.sql) is what actually
# restricts access, not this key's secrecy.
#
# NEVER put the Secret key (sb_secret_...), the Legacy JWT Secret, or any
# database password here — those belong only in apps/backend/.env.
SUPABASE_ANON_KEY=
