# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# LLM provider selection: openai | anthropic | mock
LLM_PROVIDER=mock
LLM_MODEL=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Embeddings (for local RAG)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local storage location for sessions, uploaded documents, and the vector store
STORAGE_DIR=./apps/backend/storage
